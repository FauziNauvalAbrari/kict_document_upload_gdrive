<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================
         Action & Menu
    ============================ -->
    <record id="action_kict_document" model="ir.actions.act_window">
        <field name="name">KICT Document</field>
        <field name="res_model">kict.document</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="action_kict_category" model="ir.actions.act_window">
        <field name="name">Kategori Dokumen</field>
        <field name="res_model">kict.document.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_kict_document_root"
              name="Dokumen"
              sequence="10"
              web_icon="kict_document_upload_gdrive,static/description/icon.png"/>

    <menuitem id="menu_kict_category"
              name="Kategori"
              parent="menu_kict_document_root"
              action="action_kict_category"
              sequence="1"/>

    <menuitem id="menu_kict_document"
              name="Dokumen"
              parent="menu_kict_document_root"
              action="action_kict_document"
              sequence="2"/>

    <!-- ============================
         Tree View - Dokumen
    ============================ -->
    <record id="view_kict_document_tree" model="ir.ui.view">
        <field name="name">kict.document.tree</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <tree string="Dokumen">
                <field name="name"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="fleet_id"/>
                <field name="vin_sn"/>
                <field name="bpkb_number" optional="show"/>
                <field name="license_plate" optional="show"/>
                <field name="engine_number" optional="show"/>
                <field name="contract_number" optional="show"/>
                <field name="url" widget="url"/>
            </tree>
        </field>
    </record>

    <!-- ============================
         Form View - Dokumen
    ============================ -->
    <record id="view_kict_document_form" model="ir.ui.view">
        <field name="name">kict.document.form</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <form string="Dokumen">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date" readonly="1"/>
                            <field name="category_id" readonly="1"/>
                            <field name="category_name" invisible="1"/>
                            <field name="bpkb_number" invisible="category_name != 'BPKB'"/>
                        </group>
                        <group>
                            <field name="fleet_id"/>
                            <field name="vin_sn" readonly="1"/>
                            <field name="license_plate" readonly="1" invisible="category_name != 'BPKB'"/>
                            <field name="engine_number" readonly="1" invisible="category_name != 'BPKB'"/>
                            <field name="contract_number" invisible="category_name != 'KONTRAK'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Upload dan Link">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group string="Google Drive URL">
                            <field name="url" widget="url" nolabel="1"/>
                        </group>
                    </group>

                    <group col="1">
                        <button name="action_upload_to_gdrive"
                                string="Submit to GDrive"
                                type="object"
                                class="btn-primary oe_highlight"
                                />
                                <!-- icon="fa-cloud-upload" -->
                    </group>

                    <separator string="Preview File"/>
                    <field name="drive_file_id" invisible="1"/>
                    <field name="preview_html" nolabel="1" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================
         Kanban View - Dokumen
    ============================ -->
    <record id="view_kict_document_kanban" model="ir.ui.view">
        <field name="name">kict.document.kanban</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_kict_document" create="true" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="category_name" invisible="1"/>
                <field name="fleet_id"/>
                <field name="vin_sn"/>
                <field name="bpkb_number"/>
                <field name="contract_number"/>
                <field name="url"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click shadow-sm rounded-lg bg-white overflow-hidden" style="width:280px;">
                            
                            <!-- Bagian atas: gambar preview -->
                            <t t-if="record.url.raw_value">
                                <iframe t-att-src="'https://drive.google.com/file/d/' + record.url.value.split('/d/')[1].split('/')[0] + '/preview'"
                                        style="width:100%; height:160px; border:none; object-fit:cover;"
                                        class="bg-light"
                                        readonly="1"/>

                            </t>
                            <t t-else="">
                                <div class="bg-secondary d-flex align-items-center justify-content-center text-white" style="height:160px;">
                                    <i class="fa fa-file-pdf-o fa-2x"/>
                                </div>
                            </t>

                            <!-- Tanggal dokumen -->
                        <!-- <div class="position-absolute top-0 end-0 bg-success text-white px-2 py-1 rounded-start"
                             style="font-size: 12px; opacity:0.9;">
                            <t t-esc="record.date.value or ''"/>
                        </div> -->
                        <div class="text-center text-muted" style="font-size: 16px;">
                            <t t-esc="record.date.value or ''"/>
                        </div>

                        <!-- Bagian informasi -->
                        <div class="p-3 text-center">
                            <strong class="d-block text-dark">
                                <field name="fleet_id"/>
                            </strong>

                            <!-- Tampilkan tergantung kategori -->
                            <t t-if="record.category_name.raw_value == 'BPKB'">
                                <div class="mt-2">
                                    <div class="fw-bold text-uppercase text-muted">Nomor BPKB</div>
                                    <div class="text-dark fs-6 fw-semibold">
                                        <field name="bpkb_number"/>
                                    </div>
                                </div>
                            </t>
                            
                                <t t-elif="record.category_name.raw_value == 'KONTRAK'">
                                    <div class="mt-2">
                                        <div class="fw-bold text-uppercase text-muted">Nomor Kontrak</div>
                                        <div class="text-dark fs-6 fw-semibold">
                                            <field name="contract_number"/>
                                        </div>
                                    </div>
                                </t>

                                <t t-else="">
                                <div class="mt-2">
                                    <div class="fw-bold text-uppercase text-muted">Nomor Rangka</div>
                                    <div class="text-dark fs-6 fw-semibold">
                                        <field name="vin_sn"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Tombol View & Delete -->
                        <div class="d-flex justify-content-center gap-2 pb-3">
                            <t t-if="record.url.raw_value">
                                <a t-att-href="record.url.value"
                                   target="_blank"
                                   class="btn btn-success btn-sm px-3">
                                    VIEW
                                </a>
                            </t>
                            <button type="object"
                                    name="action_delete_record"
                                    class="btn btn-danger btn-sm px-3"
                                    confirm="Apakah Anda yakin ingin menghapus dokumen ini?">
                                DELETE
                            </button>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <!-- ============================
         Tree View - Category
    ============================ -->
    <record id="view_kict_category_tree" model="ir.ui.view">
        <field name="name">kict.category.tree</field>
        <field name="model">kict.document.category</field>
        <field name="arch" type="xml">
            <tree string="Kategori Dokumen">
                <field name="name"/>
                <field name="drive_folder_id"/>
            </tree>
        </field>
    </record>

    <!-- ============================
         Form View - Category
    ============================ -->
    <record id="view_kict_category_form" model="ir.ui.view">
        <field name="name">kict.category.form</field>
        <field name="model">kict.document.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Dokumen">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="drive_folder_id" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_drive_folder"
                            string="Buat Folder di Google Drive"
                            type="object"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>