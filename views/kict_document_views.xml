<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================
         Action & Menu
    ============================ -->
    <record id="action_kict_document" model="ir.actions.act_window">
        <field name="name">KICT Document</field>
        <field name="res_model">kict.document</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <record id="action_kict_category" model="ir.actions.act_window">
        <field name="name">Kategori Dokumen</field>
        <field name="res_model">kict.document.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_kict_document_root"
              name="Dokumen KICT"
              sequence="10"/>

    <menuitem id="menu_kict_category"
              name="Kategori"
              parent="menu_kict_document_root"
              action="action_kict_category"
              sequence="1"/>

    <menuitem id="menu_kict_document"
              name="Dokumen"
              parent="menu_kict_document_root"
              action="action_kict_document"
              sequence="2"/>

    <!-- ============================
         Tree View - Dokumen
    ============================ -->
    <record id="view_kict_document_tree" model="ir.ui.view">
        <field name="name">kict.document.tree</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <tree string="Dokumen">
                <field name="name"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="fleet_id"/>
                <field name="vin_sn"/>
                <field name="url" widget="url"/>
            </tree>
        </field>
    </record>

    <!-- ============================
         Form View - Dokumen
    ============================ -->
    <record id="view_kict_document_form" model="ir.ui.view">
        <field name="name">kict.document.form</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <form string="Dokumen">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date" readonly="1"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="fleet_id"/>
                            <field name="vin_sn" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Upload dan Link">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group string="Google Drive URL">
                            <field name="url" widget="url" nolabel="1"/>
                        </group>
                    </group>

                    <group col="1">
                        <button name="action_upload_to_gdrive"
                                string="Submit to GDrive"
                                type="object"
                                class="btn-primary oe_highlight"/>
                    </group>

                    <separator string="Preview File"/>
                    <div class="oe_form_field">
                        <field name="file" widget="pdf_viewer" filename="filename" readonly="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================
         Kanban View - Dokumen
    ============================ -->
    <record id="view_kict_document_kanban" model="ir.ui.view">
        <field name="name">kict.document.kanban</field>
        <field name="model">kict.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view">
                <field name="name"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="url"/>

                <templates>
                    <div class="o_kanban_record">
                        <div class="o_kanban_card" style="padding:10px; border:1px solid #ddd; border-radius:8px;">
                            <strong><field name="name"/></strong><br/>
                            <span><field name="category_id"/></span><br/>
                            <small><field name="date"/></small><br/>
                            <a target="_blank"><field name="url" widget="url"/></a>
                        </div>
                    </div>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================
         Tree View - Category
    ============================ -->
    <record id="view_kict_category_tree" model="ir.ui.view">
        <field name="name">kict.category.tree</field>
        <field name="model">kict.document.category</field>
        <field name="arch" type="xml">
            <tree string="Kategori Dokumen">
                <field name="name"/>
                <field name="drive_folder_id"/>
            </tree>
        </field>
    </record>

    <!-- ============================
         Form View - Category
    ============================ -->
    <record id="view_kict_category_form" model="ir.ui.view">
        <field name="name">kict.category.form</field>
        <field name="model">kict.document.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Dokumen">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="drive_folder_id" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_drive_folder"
                            string="Buat Folder di Google Drive"
                            type="object"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>